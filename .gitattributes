# Normalize all text files to LF in the repo and on checkout
* text=auto eol=lf

# Windows batch files must stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets -- no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.pdf   binary
*.zip   binary
